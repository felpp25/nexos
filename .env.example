# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
TEMPERATURE=0.3
NUM_CTX=8192

# Embeddings: auto | ollama | hash
EMBED_BACKEND=auto
EMBED_MODEL=nomic-embed-text

# RAG
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
TOP_K=5
MAX_CONTEXT_CHARS=9000
HISTORY_TURNS=8

# Servidor
HOST=127.0.0.1
PORT=8770
MAX_UPLOAD_MB=60
